# Configuration EasyCatalog (Local dev & Vercel)

# 1. GitHub OAuth (obligatoire pour la connexion en 1 clic)
# Créez votre OAuth App sur https://github.com/settings/applications/new
# Homepage URL: http://localhost:5173 (ou https://votre-app.vercel.app)
# Authorization callback URL: http://localhost:5173/ (ou https://votre-app.vercel.app/)
VITE_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 2. Clé API TMDB globale (optionnelle mais recommandée pour que les visiteurs n'aient rien à configurer)
# Récupérable sur https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
